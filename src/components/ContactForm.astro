---
import Button from './Button.astro';
import siteConfig from '~/config/site';

const endpoint = 'https://api.web3forms.com/submit';
const accessKey = siteConfig.contact.web3FormsAccessKey;
const connected = accessKey.length > 0;
---

<form
  id="contact-form"
  class="form"
  method="post"
  action={connected ? endpoint : undefined}
  novalidate={false}
>
  {connected && <input type="hidden" name="access_key" value={accessKey} />}

  <div class="form-row">
    <div class="field">
      <label for="cf-name">Ваше имя</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Иван Иванов" />
    </div>
    <div class="field">
      <label for="cf-email">Электронная почта</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@company.ru" />
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Компания <span class="hint">(необязательно)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-type">Тема обращения</label>
    <select id="cf-type" name="project_type">
      <option value="company-job">Обсудить возможность работы в вашей команде</option>
      <option value="freelance">Предложение о фриланс-занятости</option>
    </select>
  </div>

  <div class="conditional-fields">
    <div class="field conditional-field is-collapsed" id="freelance-service-field" aria-hidden="true">
      <label for="cf-freelance-service">Направление проекта</label>
      <select id="cf-freelance-service" name="freelance_service" disabled>
        <option value="website">Создание сайта</option>
        <option value="web-app-integration">Веб-приложение с интеграцией в вашу систему</option>
        <option value="automation">Автоматизации (чат-боты, формы, интеграции)</option>
        <option value="llm">Внедрение LLM в ваш продукт</option>
      </select>
    </div>

    <div class="field conditional-field" id="hr-contact-field">
      <label for="cf-hr-contact">Контакт HR <span class="hint">(необязательно)</span></label>
      <input id="cf-hr-contact" name="hr_contact" type="text" placeholder="Имя, почта или Telegram" />
    </div>
  </div>

  <div class="field">
    <label for="cf-message">Описание задачи</label>
    <p class="hint" id="cf-message-hint">
      Расскажите о вакансии и команде. Можно прислать ссылку на описание.
    </p>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      aria-describedby="cf-message-hint"
      placeholder="Опишите вакансию или пришлите ссылку на неё."></textarea>
  </div>

  <!-- Web3Forms honeypot: hidden from people, visible to bots. -->
  <div class="hp" aria-hidden="true">
    <input name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" style="display:none" />
  </div>

  {
    !connected && (
      <p class="form-note">
        <strong>Форма пока не подключена.</strong> Добавьте ключ Web3Forms
        в <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> в окружении сборки, чтобы начать
        получать сообщения.
      </p>
    )
  }

  <div>
    <Button type="submit" variant="ink" icon="mail" disabled={!connected}>Отправить заявку</Button>
  </div>
  <p class="form-note" id="contact-form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const topicSelect = form.querySelector<HTMLSelectElement>('#cf-type');
    const freelanceServiceField = form.querySelector<HTMLDivElement>('#freelance-service-field');
    const freelanceServiceSelect = form.querySelector<HTMLSelectElement>('#cf-freelance-service');
    const hrContactField = form.querySelector<HTMLDivElement>('#hr-contact-field');
    const hrContactInput = form.querySelector<HTMLInputElement>('#cf-hr-contact');
    const messageHint = form.querySelector<HTMLParagraphElement>('#cf-message-hint');
    const messageField = form.querySelector<HTMLTextAreaElement>('#cf-message');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submitButton?.querySelector('span');
    const status = form.querySelector<HTMLParagraphElement>('#contact-form-status');

    topicSelect?.addEventListener('change', () => {
      const freelanceSelected = topicSelect.value === 'freelance';
      if (freelanceServiceField) {
        freelanceServiceField.classList.toggle('is-collapsed', !freelanceSelected);
        freelanceServiceField.setAttribute('aria-hidden', String(!freelanceSelected));
      }
      if (freelanceServiceSelect) {
        freelanceServiceSelect.disabled = !freelanceSelected;
        freelanceServiceSelect.required = freelanceSelected;
      }
      if (hrContactField) {
        hrContactField.classList.toggle('is-collapsed', freelanceSelected);
        hrContactField.setAttribute('aria-hidden', String(freelanceSelected));
      }
      if (hrContactInput) hrContactInput.disabled = freelanceSelected;
      if (messageHint && messageField) {
        messageHint.textContent = freelanceSelected
          ? 'Опишите задачу, для кого нужен проект и какой результат вы ожидаете.'
          : 'Расскажите о вакансии и команде. Можно прислать ссылку на описание.';
        messageField.placeholder = freelanceSelected
          ? 'Для начала достаточно пары предложений о проекте.'
          : 'Опишите вакансию или пришлите ссылку на неё.';
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!submitButton || !submitLabel || !status) return;

      const originalLabel = submitLabel.textContent ?? 'Отправить заявку';
      submitLabel.textContent = 'Отправляем…';
      submitButton.disabled = true;
      status.hidden = true;
      status.textContent = '';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Не удалось отправить сообщение.');
        }

        status.textContent = 'Спасибо! Сообщение отправлено.';
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : 'Не удалось отправить сообщение. Попробуйте ещё раз.';
      } finally {
        status.hidden = false;
        submitLabel.textContent = originalLabel;
        submitButton.disabled = false;
      }
    });
  }
</script>
