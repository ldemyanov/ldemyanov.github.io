---
import Button from './Button.astro';
import siteConfig from '~/config/site';

const endpoint = siteConfig.contact.formEndpoint.trim();
const connected = endpoint.length > 0;
---

<form
  class="form"
  method="post"
  action={connected ? endpoint : undefined}
  name="contact"
  novalidate={false}
>
  <!-- Netlify Forms picks the form up from this attribute at build time. -->
  <input type="hidden" name="form-name" value="contact" />

  <div class="form-row">
    <div class="field">
      <label for="cf-name">Ваше имя</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Иван Иванов" />
    </div>
    <div class="field">
      <label for="cf-email">Электронная почта</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@company.ru" />
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Компания <span class="hint">(необязательно)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-type">Тема обращения</label>
    <select id="cf-type" name="project_type">
      <option value="art-direction">Арт-дирекшн</option>
      <option value="interface-design" selected>Дизайн интерфейса</option>
      <option value="design-systems">Дизайн-системы</option>
      <option value="identity">Айдентика</option>
      <option value="site-build">Разработка сайта</option>
      <option value="second-opinion">Второе мнение</option>
      <option value="something-else">Другое</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Описание задачи</label>
    <p class="hint" id="cf-message-hint">
      Что нужно сделать, для кого и какой результат вы ожидаете.
    </p>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      aria-describedby="cf-message-hint"
      placeholder="Для начала достаточно пары предложений."></textarea>
  </div>

  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Оставьте это поле пустым</label>
    <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !connected && (
      <p class="form-note">
        <strong>Форма пока не подключена.</strong> Добавьте адрес сервиса обработки формы
        в <code>contact.formEndpoint</code> файла <code>src/config/site.ts</code>, чтобы
        начать получать сообщения.
      </p>
    )
  }

  <div>
    <Button type="submit" variant="ink" icon="mail" disabled={!connected}>Отправить заявку</Button>
  </div>
</form>
