---
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';
import PostCard from '../cards/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

---

{posts.length > 0 && (
  <section class="wrap sec" id="journal" aria-labelledby="jrn-h">
    <SectionHeading class="rev" eyebrow="Блог" title="Заметки о разработке" id="jrn-h">
      <Button href="/journal/" variant="outline">Все статьи</Button>
    </SectionHeading>

    <div class="posts">
      {posts.map((post, i) => (
        <PostCard post={post} class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]} />
      ))}
    </div>
  </section>
)}
