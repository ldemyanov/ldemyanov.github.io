---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { hero } from '~/data/highlights';

const techIcons = [
  { src: '/icons/react.svg', name: 'React' },
  { src: '/icons/nextjs.svg', name: 'Next.js' },
  { src: '/icons/nestjs.svg', name: 'NestJS' },
  { src: '/icons/prisma.svg', name: 'Prisma' },
  { src: '/icons/docker.svg', name: 'Docker' },
  { src: '/icons/openai.svg', name: 'OpenAI' },
];
---

<section class="wrap hero" aria-labelledby="hero-h">
  <div class="hero-grid">
    <div class="hero-l rev">
      <p class="hero-hi">{hero.greeting}</p>
      <h1 class="d1 hero-name" id="hero-h">
        {hero.nameLines.map((line) => <em>{line}</em>)}
      </h1>
      <p class="hero-copy">{hero.intro}</p>
      <Button href={hero.ctaHref} variant="lime">{hero.ctaLabel}</Button>
    </div>

    <div class="hero-card rev rev-d1">
      <div class="hero-photo">
        <img
          src={hero.photo.src}
          alt={hero.photo.alt}
          width={hero.photo.width}
          height={hero.photo.height}
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-social">
          {
            siteConfig.social.map((s) => (
              <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
                <Icon name={s.icon} class="ic-sm" />
              </a>
            ))
          }
        </div>
      </div>
      <p class="hero-avail">
        <span class="dot-live" aria-hidden="true"></span>
        {siteConfig.contact.availability}
      </p>
    </div>

    <div class="hero-right rev rev-d2">
      <p class="hero-role">
        {hero.aside.roleLine[0]}<br />{hero.aside.roleLine[1]}
      </p>
      <h2 class="d2 hero-title2">
        {hero.aside.title[0]}<br />{hero.aside.title[1]}
      </h2>
      <div class="hero-proof">
        <div class="hero-tech-icons" aria-label="Технологии: React, Next.js, NestJS, Prisma, Docker и OpenAI">
          {techIcons.map(({ src, name }) => (
            <img src={src} alt={name} title={name} width="32" height="32" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
      {hero.aside.kpi && hero.aside.kpiLabel && (
        <p class="hero-kpi">{hero.aside.kpi} <span>{hero.aside.kpiLabel}</span></p>
      )}
      {hero.aside.note && <p class="hero-note">{hero.aside.note}</p>}
    </div>
  </div>

  <Icon name="asterisk" class="hero-mark" />
</section>
