---
import Icon from '../Icon.astro';
import { stats, statsHeading, reel } from '~/data/stats';
---

<section class="band" aria-labelledby="band-h">
  <div class="wrap sec">
    <h2 class="band-h rev" id="band-h">
      {statsHeading.lead} <span>{statsHeading.tail}</span>
    </h2>

    <div class="band-row">
      <div class="vid rev rev-d1" id="reel" data-embed={reel.embedUrl || undefined}>
        <img
          src={reel.image}
          alt={reel.alt}
          width={reel.width}
          height={reel.height}
          loading="lazy"
          decoding="async"
        />
        {
          reel.embedUrl && (
            <button type="button" aria-label={reel.label}>
              <i><Icon name="play" /></i>
            </button>
          )
        }
      </div>

      <div class="stats rev rev-d2">
        {
          stats.map((stat) => (
            <div class="stat">
              <b>{stat.value}</b>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  /* --- Reel: swap the poster for the embed on click ---------------- */
  {
    const reel = document.getElementById('reel');
    const button = reel?.querySelector('button');
    const embed = reel?.dataset.embed;

    if (reel && button && embed) {
      button.addEventListener('click', () => {
        const frame = document.createElement('iframe');
        frame.src = embed.includes('?') ? `${embed}&autoplay=1` : `${embed}?autoplay=1`;
        frame.title = button.getAttribute('aria-label') ?? 'Video';
        frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        reel.replaceChildren(frame);
      });
    }
  }
</script>
