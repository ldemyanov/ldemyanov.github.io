---
import { stats, statsHeading } from '~/data/stats';
---

<section class="band" aria-labelledby="band-h">
  <div class="wrap sec">
    <h2 class="band-h rev" id="band-h">
      {statsHeading.lead} <span>{statsHeading.tail}</span>
    </h2>

    <div class="stats rev rev-d1">
      {
        stats.map((stat) => (
          <div class="stat">
            <b>{stat.value}</b>
            <span>{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
