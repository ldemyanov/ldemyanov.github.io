<!-- Canvas лежит под содержимым главной и не участвует в доступной навигации. -->
<canvas class="interactive-backdrop" id="interactive-backdrop" aria-hidden="true"></canvas>

<style>
  .interactive-backdrop {
    /* Размер области рисования выставляется скриптом под высоту всей страницы. */
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Ссылки и кнопки над фоном остаются доступными. */
    opacity: 1;
    transition: opacity 1s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Для пользователей с отключённой анимацией фон не показывается. */
    .interactive-backdrop { display: none; }
  }
</style>

<script>
  import { interactiveBackdropColors } from '~/data/interactive-backdrop';
  // Геометрия извилистых лент вынесена отдельно; здесь остаётся жизненный цикл canvas.
  import { createWorm, drawWorm, type Worm } from '~/lib/interactive-backdrop-worms';

  // Отдельный модуль добавляет window.runBackdropBenchmark только при astro dev.
  if (import.meta.env.DEV) void import('~/lib/interactive-backdrop-benchmark.js');

  const canvas = document.querySelector<HTMLCanvasElement>('#interactive-backdrop');
  const context = canvas?.getContext('2d');

  // Без canvas, 2D-контекста или разрешения на движение слушатели не нужны.
  if (canvas && context && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Буфер canvas использует один пиксель на CSS-пиксель независимо от DPR экрана.
    let width = 0;
    let height = 0;
    const pixelRatio = 1;
    // Одновременно выполняется не более одного цикла requestAnimationFrame.
    let animationFrame = 0;
    let lastFrame = 0;
    let fadeTimer = 0;
    let clearTimer = 0;
    let resizeTimer = 0;
    let initialized = false;
    let hasCanvasDrawing = false;
    let resizeObserver: ResizeObserver | null = null;
    // Первое положение указателя задаёт начало линии, но ещё ничего не рисует.
    let hasPreviousPoint = false;
    let hasPendingPointer = false;
    const mouse = { x: 0, y: 0 };
    const previous = { x: 0, y: 0 };
    const worms: Worm[] = [];

    /**
     * Подгоняет внутреннее разрешение canvas под размер страницы при DPR 1.
     * При изменении размеров переносит рисунок в новый буфер; уменьшение холста
     * естественно обрезает его за новыми границами. Контекст возвращается к CSS-пикселям.
     * @returns Ничего; меняет размеры canvas и масштаб контекста.
     */
    const resize = () => {
      width = Math.max(window.innerWidth, document.documentElement.scrollWidth);
      const footer = document.querySelector<HTMLElement>('.ftr');
      const footerTop = footer?.getBoundingClientRect().top;
      // Не используем scrollHeight: размер самого canvas может удержать старую высоту.
      height = Math.max(0, (footerTop ?? window.innerHeight) + window.scrollY);
      const canvasWidth = Math.round(width * pixelRatio);
      const canvasHeight = Math.round(height * pixelRatio);
      if (canvas.width !== canvasWidth || canvas.height !== canvasHeight) {
        const previousCanvas = hasCanvasDrawing ? document.createElement('canvas') : null;
        if (previousCanvas) {
          previousCanvas.width = canvas.width;
          previousCanvas.height = canvas.height;
          previousCanvas.getContext('2d')?.drawImage(canvas, 0, 0);
        }
        canvas.width = canvasWidth;
        canvas.height = canvasHeight;
        if (previousCanvas) {
          context.drawImage(previousCanvas, 0, 0);
          previousCanvas.width = 1;
          previousCanvas.height = 1;
        }
      }
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    };

    /**
     * Объединяет частые события изменения размеров и выполняет пересчёт через 50 мс.
     * @returns Ничего; планирует единственный отложенный пересчёт canvas.
     */
    const scheduleResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resizeTimer = 0;
        resize();
      }, 50);
    };

    /**
     * Останавливает анимацию и освобождает полноразмерный буфер при скрытии вкладки.
     * Следы сбрасываются; новый буфер будет создан при следующем движении указателя.
     * @returns Ничего; отменяет задачи, отключает наблюдение и уменьшает canvas до 1×1.
     */
    const releaseCanvasBuffer = () => {
      if (animationFrame) window.cancelAnimationFrame(animationFrame);
      window.clearTimeout(fadeTimer);
      window.clearTimeout(clearTimer);
      window.clearTimeout(resizeTimer);
      animationFrame = 0;
      fadeTimer = 0;
      clearTimer = 0;
      resizeTimer = 0;
      initialized = false;
      hasCanvasDrawing = false;
      hasPreviousPoint = false;
      hasPendingPointer = false;
      lastFrame = 0;
      worms.length = 0;
      window.removeEventListener('resize', scheduleResize);
      resizeObserver?.disconnect();
      resizeObserver = null;
      width = 0;
      height = 0;
      canvas.width = 1;
      canvas.height = 1;
      canvas.style.width = '1px';
      canvas.style.height = '1px';
      canvas.style.opacity = '1';
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    };

    /**
     * Освобождает память скрытой вкладки и ждёт указателя перед повторным выделением буфера.
     * @returns Ничего; вызывает освобождение при скрытии документа.
     */
    const handleVisibilityChange = () => {
      if (document.hidden) releaseCanvasBuffer();
    };

    /**
     * Перезапускает затухание после движения указателя. Через минуту без
     * движения canvas плавно скрывается; после перехода полностью очищается.
     * Отключение transition на время очистки не даёт старым следам вспыхнуть.
     * @returns Ничего; обновляет таймеры и прозрачность canvas.
     */
    const resetFadeTimer = () => {
      window.clearTimeout(fadeTimer);
      window.clearTimeout(clearTimer);
      canvas.style.opacity = '1';
      fadeTimer = window.setTimeout(() => {
        canvas.style.opacity = '0';
        clearTimer = window.setTimeout(() => {
          canvas.width = canvas.width;
          canvas.height = canvas.height;
          hasCanvasDrawing = false;
          context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
          worms.length = 0;
          canvas.style.transition = 'none';
          canvas.style.opacity = '1';
          // Принудительный пересчёт стилей фиксирует opacity: 1 без анимации.
          canvas.getBoundingClientRect();
          canvas.style.transition = '';
        }, 1100);
      }, 60_000);
    };

    /**
     * Превращает новое положение указателя в тонкую линию и новый широкий след.
     * Движения меньше двух пикселей пропускаются, чтобы не плодить сегменты.
     * @returns Ничего; при достаточном смещении рисует и добавляет след.
     */
    const checkPointer = () => {
      if (!hasPreviousPoint) {
        previous.x = mouse.x;
        previous.y = mouse.y;
        hasPreviousPoint = true;
        return;
      }

      const vx = mouse.x - previous.x;
      const vy = mouse.y - previous.y;
      const distance = Math.hypot(vx, vy);
      if (distance < 2) return;

      createWorm(worms, mouse.x, mouse.y, vx, vy, Math.min(distance, 50) + 8);
      context.beginPath();
      context.strokeStyle = interactiveBackdropColors.cursorTrail;
      context.lineWidth = 1;
      context.moveTo(previous.x, previous.y);
      context.lineTo(mouse.x, mouse.y);
      context.stroke();
      hasCanvasDrawing = true;
      previous.x = mouse.x;
      previous.y = mouse.y;
    };

    /**
     * Рисует следующий кадр с ограничением примерно до 50 кадров в секунду.
     * Каждый след живёт до 80 кадров; цикл останавливается, когда рисовать
     * больше нечего, и запускается снова при следующем движении указателя.
     * Несколько pointermove за кадр дают одно обновление таймера затухания.
     * @param time Время кадра от requestAnimationFrame в миллисекундах.
     * @returns Ничего; обновляет активные следы и планирует следующий кадр.
     */
    const draw = (time: number) => {
      animationFrame = 0;
      if (time - lastFrame < 20) {
        animationFrame = window.requestAnimationFrame(draw);
        return;
      }
      lastFrame = time;

      if (hasPendingPointer) {
        resetFadeTimer();
        checkPointer();
        hasPendingPointer = false;
      }

      if (worms.length) context.fillStyle = interactiveBackdropColors.ribbon;
      for (let index = worms.length - 1; index >= 0; index -= 1) {
        const worm = worms[index];
        if (!worm) continue;
        if (worm.count >= 80) {
          worms.splice(index, 1);
          continue;
        }
        drawWorm(context, worm);
        worm.count += 1;
      }

      if (worms.length || hasPendingPointer) animationFrame = window.requestAnimationFrame(draw);
    };

    /**
     * Сохраняет координаты мыши или пера для ближайшего кадра. Вертикальная
     * прокрутка добавляется к clientY, поскольку canvas покрывает всю страницу.
     * При первом таком событии создаёт полноразмерный буфер canvas и начинает
     * следить за размерами страницы. Касания не запускают эту инициализацию.
     * Несколько событий между кадрами сводятся к последней позиции.
     * @param event Событие движения указателя с типом и координатами.
     * @returns Ничего; обновляет позицию и при необходимости запускает кадр.
     */
    const handlePointerMove = (event: PointerEvent) => {
      if (document.hidden || (event.pointerType !== 'mouse' && event.pointerType !== 'pen')) return;
      if (!initialized) {
        initialized = true;
        resize();
        window.addEventListener('resize', scheduleResize, { passive: true });
        // Высота контента может измениться и без изменения размера окна.
        const shell = document.querySelector('.swp-shell');
        if (shell) {
          resizeObserver = new ResizeObserver(scheduleResize);
          resizeObserver.observe(shell);
        }
      }
      mouse.x = event.clientX;
      mouse.y = event.clientY + window.scrollY;
      hasPendingPointer = true;
      if (!animationFrame) animationFrame = window.requestAnimationFrame(draw);
    };

    // До первого движения мыши или пера остаётся маленький исходный буфер.
    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    document.addEventListener('visibilitychange', handleVisibilityChange);
  }
</script>
