---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { footerNav } from '~/data/navigation';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <p class="ftr-about">{siteConfig.about}</p>
      <div class="ftr-soc">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-labelledby="ftr-explore">
      <h2 id="ftr-explore">Навигация</h2>
      <ul class="ftr-links">
        {footerNav.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Связаться</h2>
      <div class="ftr-cbox">
        <Icon name="mail" class="ic-sm" />
        <span><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="phone" class="ic-sm" />
        <span><a href={`tel:${siteConfig.contact.phoneHref}`}>{siteConfig.contact.phone}</a></span>
      </div>
      <div class="ftr-cbox">
        <svg class="ic-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 3.75h7l4 4v12.5H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          <path d="M14 3.75v4h4M8 13h6M8 16h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <span><a href="/docs/%D0%A0%D0%B5%D0%B7%D1%8E%D0%BC%D0%B5%20%D0%94%D0%B5%D0%BC%D1%8C%D1%8F%D0%BD%D0%BE%D0%B2%20%D0%9B%D0%B5%D0%BE%D0%BD%D0%B8%D0%B4.pdf" download>Скачать резюме (PDF)</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="pin" class="ic-sm" />
        <span>{siteConfig.contact.location}</span>
      </div>
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}</p>
    <nav aria-label="Правовая информация">
      {footerNav.legal.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
