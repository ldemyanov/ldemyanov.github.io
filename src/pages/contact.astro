---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Icon from '~/components/Icon.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Главная', url: `${siteConfig.url}/` },
    { name: 'Контакты', url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title="Контакты"
  heading="Расскажите о вашей задаче."
  eyebrow="Контакты"
  intro="Опишите задачу и ожидаемый результат — этого достаточно, чтобы обсудить объём работ и стоимость."
  description={`Get in touch with ${siteConfig.author} about art direction, interface design, design systems or a one-week review.`}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="form-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="form-h" style="margin-bottom:24px">Расскажите о задаче</h2>
        <ContactForm />
      </div>

      <div class="contact-aside rev rev-d1">
        <a class="contact-card contact-card-preferred" href="https://t.me/ldemyanov" target="_blank" rel="noopener noreferrer">
          <i><img src="/photo/social/telegram.svg" width="24" height="24" alt="" /></i>
          <div>
            <b>Telegram</b>
            <small class="contact-preferred">Предпочтительный способ связи</small>
            <span>@ldemyanov</span>
          </div>
        </a>
        <a class="contact-card contact-card-preferred" href="https://wa.me/77788131612" target="_blank" rel="noopener noreferrer">
          <i><img src="/photo/social/whatsApp.svg" width="24" height="24" alt="" /></i>
          <div>
            <b>WhatsApp</b>
            <small class="contact-preferred">Предпочтительный способ связи</small>
            <span>Написать в WhatsApp</span>
          </div>
        </a>
        <a class="contact-card" href={`mailto:${siteConfig.contact.email}`}>
          <i><Icon name="mail" /></i>
          <div>
            <b>Электронная почта</b>
            <span>{siteConfig.contact.email}</span>
          </div>
        </a>
        <a class="contact-card" href={`tel:${siteConfig.contact.phoneHref}`}>
          <i><Icon name="phone" /></i>
          <div>
            <b>Телефон</b>
            <span>{siteConfig.contact.phone}</span>
          </div>
        </a>
        <div class="contact-card">
          <i><Icon name="pin" /></i>
          <div>
            <b>Город</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>
        <div class="contact-card">
          <i><Icon name="spark" /></i>
          <div>
            <b>Доступность</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
