---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Icon from '~/components/Icon.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Главная', url: `${siteConfig.url}/` },
    { name: 'Контакты', url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title="Контакты"
  heading="Расскажите о вашей задаче."
  eyebrow="Контакты"
  intro="Опишите задачу и ожидаемый результат — этого достаточно, чтобы обсудить объём работ и стоимость."
  description={`Связаться с ${siteConfig.author}, Fullstack-разработчиком из Астаны: обсудить работу в команде или фриланс-проект — сайт, веб-приложение, автоматизацию и интеграции.`}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="form-h">
    <div class="contact-grid">
      <div class="rev">
        <h2 class="d3" id="form-h" style="margin-bottom:24px">Расскажите о задаче</h2>
        <ContactForm />
      </div>

      <div class="contact-aside rev rev-d1">
        <a class="contact-card contact-card-preferred" href="https://t.me/ldemyanov" target="_blank" rel="noopener noreferrer">
          <i><img src="/photo/social/telegram.svg" width="24" height="24" alt="" /></i>
          <div>
            <b>Telegram</b>
            <small class="contact-preferred">Предпочтительный способ связи</small>
            <span>@ldemyanov</span>
          </div>
        </a>
        <a class="contact-card contact-card-preferred" href="https://wa.me/77788131612" target="_blank" rel="noopener noreferrer">
          <i><img src="/photo/social/whatsApp.svg" width="24" height="24" alt="" /></i>
          <div>
            <b>WhatsApp</b>
            <small class="contact-preferred">Предпочтительный способ связи</small>
            <span>Написать в WhatsApp</span>
          </div>
        </a>
        <a class="contact-card" href={`mailto:${siteConfig.contact.email}`}>
          <i><Icon name="mail" /></i>
          <div>
            <b>Электронная почта</b>
            <span>{siteConfig.contact.email}</span>
          </div>
        </a>
        <a class="contact-card" href={`tel:${siteConfig.contact.phoneHref}`}>
          <i><Icon name="phone" /></i>
          <div>
            <b>Телефон</b>
            <span>{siteConfig.contact.phone}</span>
          </div>
        </a>
        <a class="contact-card" href="/docs/%D0%A0%D0%B5%D0%B7%D1%8E%D0%BC%D0%B5%20%D0%94%D0%B5%D0%BC%D1%8C%D1%8F%D0%BD%D0%BE%D0%B2%20%D0%9B%D0%B5%D0%BE%D0%BD%D0%B8%D0%B4.pdf" target="_blank" rel="noopener noreferrer">
          <i aria-hidden="true"><svg class="ic" viewBox="0 0 24 24" focusable="false"><path d="M7 3.75h7l4 4v12.5H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3.75v4h4M8 13h6M8 16h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></i>
          <div>
            <b>Открыть резюме</b>
            <span>Frontend-разработчик — React, TypeScript</span>
          </div>
        </a>
        <div class="contact-card">
          <i><Icon name="pin" /></i>
          <div>
            <b>Город</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>
        <div class="contact-card">
          <i><Icon name="handshake" /></i>
          <div>
            <b>Доступность</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
