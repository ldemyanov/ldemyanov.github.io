---
import PageLayout from '~/layouts/PageLayout.astro';
import About from '~/components/home/About.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Главная', url: `${siteConfig.url}/` },
    { name: 'Обо мне', url: `${siteConfig.url}/about/` },
  ]),
]);
---

<PageLayout
  title="Обо мне"
  heading="Обо мне"
  eyebrow="Обо мне"
  intro="Я — Леонид Демьянов, fullstack-разработчик на TypeScript с 4 годами коммерческого опыта. Создаю сайты и веб-приложения для бизнеса и продуктовых команд — от идеи и архитектуры до готового решения."
  description="Леонид Демьянов — fullstack-разработчик на TypeScript из Астаны. Опыт, проекты и навыки в разработке сайтов и веб-приложений."
  jsonLd={jsonLd}
>
  <About headingLevel="h2" id="background" />
  <StatsBand />
  <Toolkit />
  <Cta />
</PageLayout>
