---
import PageLayout from '~/layouts/PageLayout.astro';
import WorkCard from '~/components/cards/WorkCard.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

const projects = (await getCollection('projects'))
  .filter(isVisible)
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Главная', url: `${siteConfig.url}/` },
    { name: 'Работы', url: `${siteConfig.url}/work/` },
  ]),
]);
---

<PageLayout
  title="Работы"
  heading="Проекты и решения для разных задач."
  eyebrow="Избранные проекты"
  intro="В кейсах показываю исходную задачу, принятые решения и результат работы."
  description="Избранные проекты в разработке сайтов, интерфейсов и цифровых продуктов."
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="work-list-h">
    <h2 class="sr-only" id="work-list-h">Все проекты</h2>

    <div class="work-grid" id="workGrid" style="margin-top:clamp(28px,3vw,44px)">
      {
        projects.map((project, i) => (
          <WorkCard
            project={project}
            eager={i < 2}
            class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
          />
        ))
      }
    </div>

    {projects.length === 0 && <p class="empty">Пока нет проектов. Добавьте проект в <code>src/content/projects/</code>.</p>}
  </section>

  <Cta />
</PageLayout>
