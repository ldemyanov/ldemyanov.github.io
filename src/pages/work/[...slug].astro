---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects'))
    .filter(isVisible)
    .filter((project) => !project.data.draft)
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(i + 1) % projects.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const projectPeriod = d.period ?? (project.id === 'sbercraft' ? 'Апрель 2024 — Сентябрь 2026' : undefined);

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Главная', url: `${siteConfig.url}/` },
    { name: 'Работы', url: `${siteConfig.url}/work/` },
    { name: d.title, url: `${siteConfig.url}/work/${project.id}/` },
  ]),
]);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={d.image?.src}
  imageAlt={d.image?.alt}
  jsonLd={jsonLd}
>
  <article>
    <section class="wrap phero">
      <div class="rev">
        <p class="eyebrow">{d.category}{d.year && ` · ${d.year}`}</p>
        <h1 class="d1" style="font-size:clamp(38px,6.4vw,76px);margin:16px 0 20px">{d.title}</h1>
        <p class="lead" style="max-width:58ch">{d.description}</p>
      </div>
    </section>

    <section class="wrap" style="padding-bottom:var(--sec)">
      <div class:list={['case-media', ['sbercraft', 'forus-site', 'geological-map', 'forus-client-account'].includes(project.id) && 'case-media-sbercraft', 'rev']}>
        <img
          src={d.image.src}
          alt={d.image.alt}
          width={d.image.width}
          height={d.image.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="case-grid">
        <div class="rev">
          <div class="prose"><Content /></div>

          {
            d.results.length > 0 && (
              <div class="results">
                {d.results.map((r) => (
                  <div class="result">
                    <b>{r.value}</b>
                    <span>{r.label}</span>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <aside class="case-aside rev rev-d1" aria-label="Информация о проекте">
          <div class="case-fact">
            <b>Клиент</b>
            <p>{d.client}</p>
          </div>
          {(projectPeriod || d.year) && (
            <div class="case-fact">
              <b>{projectPeriod ? 'Время' : 'Год'}</b>
              <p>{projectPeriod ?? d.year}</p>
            </div>
          )}
          {
            d.services.length > 0 && (
              <div class="case-fact">
                <b>Услуги</b>
                <ul>{d.services.map((s) => <li>{s}</li>)}</ul>
              </div>
            )
          }
          {
            d.technologies.length > 0 && (
              <div class="case-fact">
                <b>Технологии</b>
                <div>{d.technologies.map((t) => <span class="pill">{t}</span>)}</div>
              </div>
            )
          }
          {
            d.externalUrl && (
              <Button href={d.externalUrl} variant="outline">Открыть сайт</Button>
            )
          }
        </aside>
      </div>

      <div class="nextprev">
        <a href={`/work/${next.id}/`}>
          <b>Следующий проект</b>
          <span>{next.data.title}</span>
        </a>
        <a href="/work/">
          <b>Другие проекты</b>
          <span>Все проекты</span>
        </a>
      </div>
    </section>
  </article>

  <Cta />
</BaseLayout>
